{
  "name": "risc-v-asm",
  "version": "0.0.0",
  "description": "Lightweight RISC-V RV64I/RV64M assembler and instruction encoder for Node.js with a GNU-as-style CLI, flat binary output, and Intel HEX support.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.2.0"
  },
  "imports": {
    "#index": {
      "@risc-v-asm/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "#assemble": {
      "@risc-v-asm/source": "./src/assemble/index.ts"
    },
    "#instructions": {
      "@risc-v-asm/source": "./src/instructions/index.ts"
    },
    "#package.json": {
      "@risc-v-asm/source": "./package.json",
      "default": "./package.json"
    },
    "#*": {
      "@risc-v-asm/source": "./src/*.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "risc-v-asm": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rimraf dist && npm run build:types && npm run build:bundle",
    "build:bundle": "esbuild src/index.ts src/bin.ts --bundle --platform=node --format=esm --tree-shaking=true --packages=external --sourcemap=external --splitting --chunk-names=chunks/[name]-[hash] --outdir=dist --outbase=src",
    "build:types": "rolldown -c rolldown.config.mjs",
    "test": "tsx --conditions @risc-v-asm/source --test \"src/**/*.test.ts\"",
    "lint": "oxlint --tsconfig ./tsconfig.json src testing",
    "lint:fix": "oxlint --tsconfig ./tsconfig.json --fix src testing",
    "format": "prettier --write \"src/**/*.ts\" \"testing/**/*.ts\" oxlint.config.ts rolldown.config.mjs \"*.{json,md}\" \"tsconfig*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"testing/**/*.ts\" oxlint.config.ts rolldown.config.mjs \"*.{json,md}\" \"tsconfig*.json\"",
    "type-check": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run type-check && npm test",
    "fix": "npm run format && npm run lint:fix"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rolldown": "^1.3.3",
    "rolldown-plugin-dts": "^0.30.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "risc-v",
    "riscv",
    "rv64",
    "rv64i",
    "rv64im",
    "assembler",
    "assembly",
    "instruction-encoder",
    "machine-code",
    "intel-hex",
    "flat-binary",
    "firmware",
    "bare-metal",
    "toolchain",
    "nodejs",
    "typescript",
    "cli"
  ]
}
